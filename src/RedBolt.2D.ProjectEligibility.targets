<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt.ProjectEligibility.targets" />
  <PropertyGroup>
    <_RedBoltProjectModuleEnabled Condition="'$(MSBuildProjectName)' == 'RedBolt.2D'">$(RedBolt2DEnabled)</_RedBoltProjectModuleEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(_RedBoltProjectPlatformEnabled)' == 'true' and '$(_RedBoltProjectPlatformSupported)' == 'true' and '$(_RedBoltProjectModuleEnabled)' == 'true'">true</RedBoltProjectBuildEnabled>
    <RedBoltProjectBuildEnabled Condition="'$(RedBoltIgnoreBuildSelection)' == 'true'">true</RedBoltProjectBuildEnabled>
    <BuildDependsOn Condition="'$(MSBuildProjectName)' == 'RedBolt.2D.Build'">RedBoltBuildSelectedProjects</BuildDependsOn>
    <RebuildDependsOn Condition="'$(MSBuildProjectName)' == 'RedBolt.2D.Build'">RedBoltBuildSelectedProjects</RebuildDependsOn>
    <CleanDependsOn Condition="'$(MSBuildProjectName)' == 'RedBolt.2D.Build'">RedBoltCleanSelectedProjects</CleanDependsOn>
  </PropertyGroup>
</Project>
