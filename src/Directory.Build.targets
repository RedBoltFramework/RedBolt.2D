<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt/ExternalModule/Directory.Build.targets" />

  <Target Name="RedBolt2DConfigureProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltPlatform)' == 'browser-wasm' and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))">
        <AdditionalProperties>RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))">
        <AdditionalProperties>RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
