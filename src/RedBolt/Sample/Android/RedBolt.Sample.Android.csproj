<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- <redbolt-generated name="android-project-properties"> -->
    <AssemblyName>RedBolt.2D.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.x2d.samples</ApplicationId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- </redbolt-generated name="android-project-properties"> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- <redbolt-generated name="android-project-items"> -->
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../2D/RedBolt.2D.csproj" />
    <ProjectReference Include="../../../../../RedBolt/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" />
    <Compile Include="../Urho2DSprite/**/*.cs" Link="Samples/RedBolt2D/Urho2DSprite/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Urho2DParticle/**/*.cs" Link="Samples/RedBolt2D/Urho2DParticle/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Urho2DSpriterAnimation/**/*.cs" Link="Samples/RedBolt2D/Urho2DSpriterAnimation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Urho2DTileMap/**/*.cs" Link="Samples/RedBolt2D/Urho2DTileMap/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Urho2DStretchableSprite/**/*.cs" Link="Samples/RedBolt2D/Urho2DStretchableSprite/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../../bin/CoreData.2D/**/*" Link="CoreData/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../../bin/SampleData.2D/**/*" Link="SampleData/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- </redbolt-generated name="android-project-items"> -->
  </ItemGroup>
  <!-- <redbolt-generated name="android-project-import"> -->
  <Import Project="../../../../../RedBolt/eng/RedBolt.ModuleBuild/AndroidSample.targets" />
  <!-- </redbolt-generated name="android-project-import"> -->
  <!-- <redbolt-generated name="android-project-targets"> -->
  <Target Name="RedBoltBuildAggregateAndroidNativeModules" BeforeTargets="RedBoltPrepareAndroidRuntime" Condition="'@(RedBoltAggregateAndroidNativeProject)' != ''">
    <MSBuild Projects="@(RedBoltAggregateAndroidNativeProject)" Targets="Restore;RedBoltPrepareAndroidRuntime" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot);RedBoltPlatform=$(RedBoltPlatform);RuntimeIdentifier=$(RuntimeIdentifier);RedBoltBuildAllAndroidPackages=false" RemoveProperties="TargetFramework" />
  </Target>
  <!-- </redbolt-generated name="android-project-targets"> -->
</Project>
