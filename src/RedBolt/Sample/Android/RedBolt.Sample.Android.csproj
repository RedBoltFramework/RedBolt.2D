<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.2D.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.x2d.samples</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../2D/RedBolt.2D.csproj" />
    <Compile Include="../Urho2DParticle/**/*.cs;../Urho2DSprite/**/*.cs;../Urho2DSpriterAnimation/**/*.cs;../Urho2DStretchableSprite/**/*.cs;../Urho2DTileMap/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(RedBolt2DRoot)/bin/CoreData/**/*" Link="CoreData/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(RedBolt2DRoot)/bin/Data/**/*" Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/AndroidSample.targets" />
</Project>
