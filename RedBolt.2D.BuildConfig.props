<Project>
  <PropertyGroup>
    <RedBolt2DEnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',2d,'))">true</RedBolt2DEnabled>
    <RedBolt2DEnabled Condition="'$(RedBolt2DEnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',2d,'))">true</RedBolt2DEnabled>
    <RedBolt2DEnabled Condition="'$(RedBolt2DEnabled)' == ''">false</RedBolt2DEnabled>
  </PropertyGroup>
</Project>
